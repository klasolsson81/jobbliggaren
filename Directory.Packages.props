<Project>
  <ItemGroup>
    <!-- Mediator (CQRS via source generator) -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <!-- EF Core — Application uses DbSet<T> as abstraction per ADR 0009 (bridge pattern).
         Provider-specific packages (Npgsql, Relational) stay in Infrastructure. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- MTP code coverage-extension (Microsoft, ADR 0044). Auto-registreras via
         MTP.MSBuild, exponerar coverage-CLI-switcharna för xUnit v3-runnern.
         Test-only, dras in via tests/Directory.Build.props med
         PrivateAssets=all. Web-verifierad senaste stabila 2026-05-17 (nuget.org).
         HELD AT 18.8.0 (#1157, 2026-08-02). 18.9.0 was taken and CI measured it: all 22 160 tests
         pass, and then ReportGenerator reports `The report file pattern
         'tests/**/coverage.cobertura.xml' found no matching files` — the collector stops producing
         a cobertura file where build.yml's glob looks for it. The `coverage` gate then dies two
         steps later on a missing Summary.json, which names the wrong thing. `dotnet build` and
         `dotnet test` are BOTH green on 18.9.0; only scripts/coverage.sh is not, so a bump of this
         package must be verified with that script and never with the test suite alone. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- NSubstitute 6.0.0 (#1163, 2026-08-02). 6.0.0 enables nullable annotations on the whole
         public API for .NET 8+. The only migration upstream documents is
         <Nullable>disable</Nullable> (BreakingChanges.md, github.com/nsubstitute/NSubstitute,
         read 2026-08-02) — out of bounds here: it would mute the analysis for every test project,
         not just these call sites. The three shapes it breaks, all derived by building rather than
         from the release notes, which do not enumerate them:
           1. Substitute.For<T>(store, null, ...)  — ctor args are non-nullable object[] -> `null!`.
           2. Arg.Is<T>(x => x.Foo == y)           — predicate parameter is now T?.
           3. ci[0] / ci.Arg<T>()                  — CallInfo accessors return nullable -> ArgAt<T>(n).
         Shape 2 takes `x != null &&`, NOT `x is not null &&`: Arg.Is binds
         Expression<Predicate<T>>, and an expression tree may not contain an `is` pattern (CS8122).
         All 67 guard sites hit that. That is a fact about Arg.Is, not about NSubstitute 6: the
         release also ships ArgMatchers.Matching (a plain Predicate<T>, .NET 6+, via
         `using static NSubstitute.ArgMatchers`), where the pattern form IS legal, and which is what
         a site needing `x?.Foo` — also illegal in an expression tree — would have to use.
         Declined here: migrating 67 sites to a second matcher API buys no behaviour.
         Shape 3 trades one signal away, knowingly. Arg<T>() resolves BY TYPE and raises
         AmbiguousArgumentsException when a signature grows a second parameter of that type;
         ArgAt<T>(n) resolves BY POSITION and cannot. A new leading parameter of a DIFFERENT type
         still fails loudly (InvalidCastException); one of the SAME type would silently read the
         wrong argument. Accepted because position 0 was verified against every port signature at
         the time of the change, and the alternative — `Arg<T>()!` — hides a bare null-forgiving
         operator instead. Re-verify position if any of these ports gains a parameter. -->
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Load-test (ADR 0045 Beslut 4, BUILD.md §3.1, Klas-GO 2026-05-17).
         NBomber = .NET-native load-test, ren C#, xUnit/MTP-stack-koherent
         (k6 avvisat — ny JS-toolchain bryter CLAUDE.md §1/§3.1 + CCP).
         Endast perf/Jobbliggaren.LoadTests (utanför Jobbliggaren.sln → backend-
         testjobb + coverage-gate ADR 0044 orörda). Observe-only Fas 1.
         Web-verifierad senaste stabila 2026-05-17 (nuget.org: NBomber 6.3.0).
         BenchmarkDotNet medvetet EJ adderat (Klas-deferral 2026-05-17 —
         micro-benchmark-spåret skjuts till Fas 7/dedikerad benchmark-HW). -->
    <PackageVersion Include="NBomber" Version="6.3.0" />
    <PackageVersion Include="NBomber.Http" Version="6.1.0" />
    <!-- Mono.Cecil — IL-introspektor för Architecture.Tests-projekt (TD-48 Trust=true-läckage-scan).
         Transitiv via NetArchTest.Rules men explicit-referensen tillåter direkt `using Mono.Cecil`
         i string-table-scanning. De facto standard för .NET IL-manipulation (Mono, JetBrains,
         Microsoft.NET.ILLink). Test-only. -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!-- Api -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Integration testing -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- Worker host -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- DI-abstraktion i Application (IServiceScopeFactory för snapshot child-scope,
         root-cause-fix 2026-05-16). Ren DI-abstraktion (ej EF/ASP.NET) → Clean Arch OK.
         Tidigare transitiv via FluentValidation.DependencyInjectionExtensions;
         explicit ref = versionshygien (senior-cto-advisor + dotnet-architect 2026-05-16). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- Auth + JWT -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- Health checks — TD-29 / F2-P6 strict readiness-probe.
         Microsoft.Extensions.Diagnostics.HealthChecks.* är Microsoft-paket (inte Xabaril).
         AddDbContextCheck<T> pingar DbContext via SELECT 1, returnerar Healthy/Unhealthy.
         Redis-check skrivs som custom IHealthCheck via IConnectionMultiplexer.IsConnected
         — undviker third-party Xabaril-dep, ~10 rader kod. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <!-- Redis -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <!-- Test — Redis container -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <!-- Transitive CVE pin: Testcontainers 4.13.0 declares SSH.NET >= 2025.1.0 (measured in
         its nuspec, all TFM groups), which is vulnerable to GHSA-q939-rpr3-3284 (HIGH —
         ScpClient recursive download allows arbitrary file write via server-controlled SCP
         filenames). Vulnerable range <= 2025.1.0; first patched 2026.0.0. We do not reference
         SSH.NET directly and never call ScpClient — the pin applies only via
         CentralPackageTransitivePinningEnabled (Directory.Build.props) to eliminate NU1903,
         which otherwise fails restore REPO-WIDE under TreatWarningsAsErrors and blocks every
         PR. 4.13.0 is the latest Testcontainers, so there is no bump to take instead; 2026.0.0
         is above the declared floor → upward unification, no NU1605/downgrade, and it ships a
         net10.0 group. Verified 2026-08-13 (GitHub Advisory Database, nuget.org). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Smart enum — state machines i domänen -->
    <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0" />
    <!-- Hangfire — schedulerade jobb i Worker (BUILD.md §16, ADR 0023) -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Jobbliggaren.Migrate — DDL-init console-app (STEG 14b). Behöver Npgsql direkt
         (Application använder bara DbSet<T>-abstraktionen via EF Core).
         Microsoft.Extensions.Logging.Console för stdout (+ Seq-sink, TD-104). -->
    <!-- Npgsql 10.0.3 minimum: matchar transitiv-krav från Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3,
         vars nuspec deklarerar `Npgsql 10.0.3` (verifierat 2026-08-02 mot den upplösta paketet).
         Direkt-referens från Jobbliggaren.Migrate.
         *(Meningen namngav tidigare 10.0.1/>= 10.0.2 och var stale redan på main, där provider-pinnen
         låg på 10.0.2 och Npgsql-pinnen på 10.0.3; bumpen i denna PR vidgade den, så den syncas här
         i stället för att bäras vidare.)* -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- AWSSDK-ytan är TOM och är återigen ett förbud, inte en allow-list (#183, 2026-08-15).
         Bannade: SecretsManager (TD-105 / #199 / ADR 0050), KeyManagementService +
         Core-som-krypteringsberoende (#802 — fält-krypteringen är Local-only, ADR 0049/0050),
         S3, Bedrock, SimpleEmailV2 och varje AWSSDK.Extensions.Logging.* / AWS.Logger.*.
         Historiken bakom raden, eftersom den förklarar varför förbudet en gång vidgades och
         inte bör vidgas igen på lösa grunder: SimpleEmailV2 raderades 2026-06-06 med hänvisning
         till ADR 0066 — och den hänvisningen var härledd, inte skriven: ADR 0066 nämner aldrig
         SES (mätt 2026-08-08, noll förekomster av "SES"/"SimpleEmail" i den filen). Den rev den
         DEPLOYADE dev-stacken och bevarade uttryckligen kontonivå-ytan. ADR 0124 tog därför
         tillbaka paketet som en allow-list om exakt ett id; #183 flyttade e-posten till Scaleway,
         vars arm inte behöver något paket alls, så allow-listan föll bort med sin enda medlem.
         NoAmazonReferenceTests bär förbudet och sina icke-vakuitetsankare. -->

    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <!-- TD-104 / Pre-4 STEG 6 — persistent strukturerad logg-sink (senior-cto-advisor
         Variant B: MEL → Seq, additivt på befintlig MEL-pipeline; Serilog avvisat YAGNI).
         9.0.0 = senaste stabila (net8/net9/netstandard2.0-asset). .NET 10-kompatibel:
         net9-assetet konsumeras forward-compat, och dep MEL/MEL.Configuration `>= 9.0.0`
         unifieras UPPÅT till 10.x som redan finns i projektet (ingen downgrade/NU1605).
         Web-verifierad 2026-06-14 (nuget.org). Config-gated via Seq:ServerUrl. -->
    <PackageVersion Include="Seq.Extensions.Logging" Version="9.0.0" />
    <!-- Transitiv CVE-pinning. Hangfire (och NetArchTest.Rules) drar in Newtonsoft.Json 11.0.1
         vilket är sårbar mot CVE-2024-21907 (GHSA-5crp-9r3c-p9vr — DoS via StackOverflow vid
         djupt nestade JSON). Vi använder inte Newtonsoft direkt — pinningen sker bara via
         CentralPackageTransitivePinningEnabled (Directory.Build.props) för att eliminera
         CVE-warningen som annars failar build under TreatWarningsAsErrors. 13.0.3 är senaste
         stabila version och första post-fix release-linje. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- F2-P8b JobTech-integration (ADR 0032). Refit för JobSearch (klassisk REST/JSON,
         BUILD.md §3.1). Microsoft.Extensions.Http.Resilience för retry+CB+rate-limit
         (Polly v8 under huven, ersätter deprecated Microsoft.Extensions.Http.Polly).
         WireMock.Net.xUnit för integration-tester av JobTech-shape + resilience-fallbacks
         (transient 503, rate-limit 429, polymorft event-schema).
         10.2.0 = 10.1.6 OM-SIGNERAD med giltigt cert (drop-in, non-breaking). 10.1.6:s
         författar-signeringscert (Glenn Watson) återkallades uppströms 2026-06-02 →
         NU3012 i audit-jobbet. Bump till 10.2.0 löser cert-blockern utan kodändring.
         11.x medvetet EJ valt (breaking error/exception-modell — egen framtida touch).
         Web-verifierad 2026-06-06 (reactiveui/refit #2114, nuget.org). -->
    <PackageVersion Include="Refit" Version="11.2.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="11.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="WireMock.Net" Version="1.25.0" />
    <!-- Transitiv CVE-pinning: WireMock.Net 1.25.0 drar in OpenTelemetry.Api 1.14.0 +
         OpenTelemetry.Exporter.OpenTelemetryProtocol 1.14.0 vilka är sårbara mot
         CVE-2026-40894 (GHSA-g94r-2vxg-569j, GHSA-4625-4j76-fww9, GHSA-mr8r-92fq-pj8p,
         GHSA-q834-8qmm-v933 — excessive memory allocation vid propagation-header-
         parsing). Fix från 1.15.3 (web-verifierat 2026-05-12). Pinnas via
         CentralPackageTransitivePinningEnabled (Directory.Build.props). -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <!-- Transitiv CVE-pinning: WireMock.Net 1.25.0 drar in Scriban.Signed 5.5.0
         (response-templating-motorn) vilken är sårbar mot GHSA-24c8-4792-22hx
         (array-multiplikation → obegränsad minnesallokering, DoS, High severity) plus
         syskon-advisories i samma juni-2026-Scriban-våg (StackOverflow-DoS, sandbox-escape).
         Vi använder inte Scriban direkt (ingen `using Scriban` i src/tests) — pinningen sker
         bara via CentralPackageTransitivePinningEnabled (Directory.Build.props) för att
         eliminera NU1903 som annars failar restore under TreatWarningsAsErrors. 7.2.5 =
         senaste patch (advisory fixad i 7.2.0); WireMock.Net deklarerar Scriban.Signed
         >= 5.5.0 → uppåt-unifiering, ingen NU1605/downgrade. Web-verifierad 2026-06-30
         (nuget.org, GitHub Advisory Database). -->
    <PackageVersion Include="Scriban.Signed" Version="7.2.5" />
    <!-- Transitive CVE pin: Microsoft.AspNetCore.OpenApi 10.0.10 pulls in Microsoft.OpenApi
         2.0.0 transitively, which is vulnerable to GHSA-v5pm-xwqc-g5wc (HIGH — circular
         schema references may terminate OpenAPI parsing; DoS). Vulnerable range
         >= 2.0.0-preview11, <= 2.7.4; first patched 2.7.5. We do not reference
         Microsoft.OpenApi directly — the pin applies only via
         CentralPackageTransitivePinningEnabled (Directory.Build.props) to eliminate NU1903,
         which otherwise fails restore repo-wide under TreatWarningsAsErrors. 2.7.5 stays in
         the same 2.x major that Microsoft.AspNetCore.OpenApi 10.0.10 declares (>= 2.0.0) →
         upward unification, no NU1605/downgrade. Verified 2026-07-01 (GitHub Advisory
         Database GHSA-v5pm-xwqc-g5wc, nuget.org). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Fas 4 lokal NLP-tier (ADR 0071 Beslut 6, BUILD.md §3.1 — INLÅST Pre-4 STEG 4;
         version-pin = Fas 4 STEG 0/F4-0). Deterministisk svensk NLP, ingen AI/LLM, körs
         lokalt på VPS:en. Catalyst medvetet UTE v1 (ADR 0071 Open Question 1, CTO-dom:
         Snowball/libstemmer-only; YAGNI + 512 MiB Worker-minnesbudget ADR 0045 + paritet
         mot Postgres to_tsvector('swedish') — läggs till reaktivt först om ett mätt
         F4-9/10-kriterium bevisar POS/lemma-behov). PackageReference + faktisk användning
         följer i F4-2 (NLP-grund); F4-0 = endast version-pin (gate-clearing). En oanvänd
         central PackageVersion är inert (ingen restore-/build-effekt utan PackageReference).
         sv_SE-ordlistan (DSSO, LGPL-3.0) är ett oförändrat separat data-asset, EJ NuGet —
         kan ej pinnas som PackageVersion; reds ut/wiras i F4-2.
         Copyleft-separation (security-auditor 2026-06-14, BUILD.md §3.1-notis): produkten
         distribueras inte som binär (server-side, ADR 0050) → ingen copyleft på produktkoden;
         Hunspell-trilicens → MPL 1.1 vald (LGPL 2.1 fallback, ALDRIG GPL 2.0); oförändrad
         NuGet-binär. THIRD-PARTY-NOTICES samlas vid Fas 4 build-time.
         net10-resolution re-verifierad (CLAUDE.md §9.5, nuget.org 2026-06-14):
         WeCantSpell.Hunspell 7.0.1 = net8.0/netstandard2.0-asset (forward-compat, 0 transitiv
         konflikt); libstemmer.net 2.2.3 = netstandard2.0, INGA beroenden. -->
    <PackageVersion Include="libstemmer.net" Version="2.2.3" />
    <PackageVersion Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <!-- Fas 4 STEG 8 (F4-8, ADR 0071/0074, BUILD §3.1) — deterministic CV import/parse
         tier (PDF/DOCX text extraction). NO AI/LLM. Version-pin gate-clearing; the
         PackageReference lives ONLY in Jobbliggaren.Infrastructure (Clean Arch — the
         SDK types never cross the Application port surface, parity ITextAnalyzer).
         Both permissive (no copyleft vs ADR 0050): PdfPig = Apache-2.0, OpenXml = MIT.
         Web-verified 2026-06-15 (nuget.org / GitHub LICENSE):
           PdfPig 0.1.14 = latest STABLE (0.1.15 is alpha-only); netstandard2.0/net6.0
             asset → net10.0 forward-compat (parity libstemmer.net/Hunspell), 0 transitive
             conflict; sub-1.0 API-instability noted → exact pin, bump only under review.
           DocumentFormat.OpenXml 3.5.1 = latest stable; NATIVE net10.0 asset. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- Fas 4 STEG 10 (F4-10, ADR 0071/0074, BUILD §3.1) — deterministic CV render tier
         (ATS-plain + visual PDF from the same JSON source). NO AI/LLM. The PackageReference
         lives ONLY in Jobbliggaren.Infrastructure (Clean Arch — the QuestPDF SDK types never
         cross the Application port surface, parity PdfPig/OpenXml). License = Community
         (source-available, free under USD 1M revenue, NON-COPYLEFT assessed against the server-side, non-distributed model ADR 0050 locks; not OSI-MIT) —
         set once via QuestPDF.Settings.License = LicenseType.Community in AddCvRendering.
         Web-verified 2026-08-02 (nuget.org / questpdf.com/license): 2026.7.2 = latest stable
         (published 2026-07-29), and it ships a NATIVE net10.0 asset - measured in this repo's own
         project.assets.json, where compile AND runtime both resolve to lib/net10.0/QuestPDF.dll.
         (An earlier draft of this line said "net8.0 forward-compat"; the truth is stronger.)
         THE COMMUNITY LICENCE CHANGED, v2.0 (2026-06-10) -> v3.0 (2026-07-06). An earlier draft of
         this line called it "unchanged" while freshly dated, and a second draft then misdescribed
         two of the changes. Measured against both resolved packages' LICENSE.md:
         (1) v3.0 ABOLISHED Developer counting - the 90-day rolling count and the &lt;=10/&gt;10 tier split
             are gone, and :110 says "The number of Developers never determines your license tier."
             The new AI-authorship clause is therefore ANTI-AVOIDANCE (it closes "no human wrote the
             integration, so we have zero Developers"), not a threshold we can trip. Net effect on us:
             neutral to favourable.
         (2) Source-form redistribution was ALREADY excluded in v2.0 - Grant #3 was compiled-only.
             v3.0 deletes a contradictory Copyright Notice sentence and states the denial outright.
             It removed an inconsistency, not a right.
         (3) "Developer" did not gain test code; v2.0 already listed "tests". v3.0 moves it from the
             person axis to the artefact axis. (The non-coding-QA exclusion is NOT a v3.0 change -
             v2.0 carries it verbatim.) No consequence for us either way.
         WE REMAIN COMMUNITY-ELIGIBLE ON THE REVENUE GROUND - categories (1) individual / (6) small
         business, USD 1M threshold, unchanged. NOT on category (5) open-source: that requires an
         OSI-approved licence and ours is PolyForm Noncommercial (ADR 0072), deliberately not OSI.
         And NOT via (7) transitive-dependency: CvDocumentComposer calls QuestPDF APIs directly.
         Known conditional limit: public-sector entities are ineligible REGARDLESS of revenue.
         THE LICENCE AUTHORITY ALREADY EXISTS, and an earlier draft of this comment claimed it did
         not. ADR 0071 carries a Library/License/Purpose table, a formal "License correction"
         (2026-06-14) with security-auditor sign-off, and its 2026-06-14 License correction note
         concludes: "BUILD.md 3.1 is the authoritative license source going forward." So BUILD.md 3.1 -
         not this line - is the designated home; no new ADR is needed. Licence FACTS belong there; what
         lives here is the working note behind them. That draft
         reached the opposite conclusion from `grep -cniE "licen[cs]" ADR-0050` returning 0 - true,
         but it does not carry the claim: nobody said ADR 0050 was a licence document. "non-copyleft
         vs ADR 0050" is this repo's idiom for "assessed against the server-side, non-distributed
         model ADR 0050 locks" - which is ADR 0071:170's own wording, not merely local shorthand.
         Measured 2026-08-15: TWO other comment blocks here assess copyleft against ADR 0050, covering four
         packages (libstemmer+Hunspell, PdfPig+OpenXml). One uses the shorthand; the Hunspell
         block already writes it out. Both numbers dropped by one block / one package when the
         AWSSDK.SimpleEmailV2 row was deleted with the SES arm (#183) — the Scaleway replacement adds
         no package at all, so it adds no licence claim to count. An earlier draft said "four other rows"
         - reachable only by counting ADR 0050 MENTIONS, one of which was a package REMOVAL and no
         licence claim at all.
         MECHANISM WORTH KNOWING: v3.0 adds `## Applicable Version` (the Community License section's only new
         section). Document-wide the count is four added - `Choosing Between Professional and
         Enterprise`, `Renewal Pricing`, `Applicable Version`, `Application of This Version` - and one
         removed, `Larger Businesses`, which is exactly where v2.0's &lt;=10/&gt;10 tier split lived. Naming
         the removal is what carries point (1); a net "+3" does not. The licence shipped WITH a release governs
         that release, so a NuGet bump CHANGES WHICH LICENCE VERSION GOVERNS - and nothing in this
         repo reads the licence at a bump. -->
    <PackageVersion Include="QuestPDF" Version="2026.8.0" />
    <!-- INGET e-postpaket, och det är resultatet av ett leverantörsbyte och inte ett glapp (#183).
         AWSSDK.SimpleEmailV2 togs bort 2026-08-15 när transaktionell e-post flyttade från Amazon
         SES v2 till Scaleway Transactional Email (fr-par). Scaleway publicerar officiella SDK:er
         för Python, Go och JavaScript och ingen för .NET (mätt mot deras egen SDK-sida
         2026-08-15), så armen är en handrullad HttpClient + System.Text.Json — båda BCL. Ersättaren
         är alltså INGET paket, vilket är varför den här filen blev en rad kortare i stället för att
         byta ett id mot ett annat.
         Följden för vakten: NoAmazonReferenceTests är inte längre en allow-list utan ett
         totalförbud — noll Amazon-paket i någon csproj/props/targets under src/, tests/ och perf/
         plus rotens byggfiler, och noll Amazon-importer i någon .cs under samma rötter. Lägg inte tillbaka
         ett AWSSDK-paket "bara för att"; kryptering är fortsatt Local-only (#802) och
         SecretsManager/KeyManagementService/S3/Bedrock/AWS.Logger.* var bannade redan innan. -->
  </ItemGroup>
</Project>