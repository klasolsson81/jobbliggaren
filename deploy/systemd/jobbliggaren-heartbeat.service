[Unit]
# #1201 — gate M-7. The box's cadenced reader of its own alarm surface, and the sender of the
# dead-man ping.
#
# WHY IT EXISTS. Every signal this box produces — `systemctl --failed`, the journal, the
# reconcile stamp — was read by nobody on any cadence (measured 2026-08-10). A signal nobody
# reads is not awareness, and Art. 33's clock runs from awareness. This unit is the reader.
#
# WHAT IT IS NOT. It is not a log sink (#1175) and not application-level alerting (#1172). It
# reports THAT something is wrong and never ships the corpus; the forensic trail stays local and
# is root-erasable until #1175 lands. That limit is named in docs/runbooks/host-detection.md
# rather than left for a reader to discover.
Description=Jobbliggaren: read the box's alarm surface and ping the dead-man expecter
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/host-detection.md

[Service]
Type=oneshot
# INTOLERANT ON PURPOSE. Without the ping URL this unit cannot do its job, so it fails rather
# than pretending — and the dead-man is the backstop that turns that failure into a page. The
# two layers covering each other is the property, and the drill measures it.
EnvironmentFile=/etc/jobbliggaren/detection.env
ExecStart=/opt/jobbliggaren/deploy/systemd/jobbliggaren-heartbeat.sh
# The script always exits 0 by contract: it must never land on the failure list it reads, or its
# own presence would make the predicate permanently false and the alarm permanently lit.
TimeoutStartSec=60
Restart=no
RemainAfterExit=no

# NO [Install] SECTION — the timer enables this pair, matching every other unit in this repo.
