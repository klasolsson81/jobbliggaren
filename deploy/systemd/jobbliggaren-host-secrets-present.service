[Unit]
# #1329 — ABSENCE detection for the HOST-ONLY secrets (#197's backup upload credential today).
#
# WHY THIS IS A SECOND UNIT AND NOT A SECOND CHECK INSIDE THE FIRST. Until it existed, one
# predicate answered for two sets with different owners, different severity and different
# provisioning lifecycles — and it cost twice, both measured on the box 2026-08-13. The summary
# could not be true of both sets at once (#1328). And the crypto alarm could not be ENABLED at
# all until the lower-severity set was provisioned, because its absence failed the shared
# predicate and put a permanent entry on `systemctl --failed` — which, through
# jobbliggaren-heartbeat.sh's P1, is a continuous page (#1329). Split, jobbliggaren-secrets-
# present.timer arms on the day the crypto secrets exist and owes #197 nothing.
#
# WHAT IT DETECTS, AND WHAT THAT COSTS. Absence of a host-only secret does not stop api or
# worker: nothing here is bind-mounted into a container. jobbliggaren-backup.service carries
# ConditionPathExists on the same file and SKIPS its scheduled run rather than failing — inactive,
# logged, not failed — deliberately, so it never latches. That is exactly why this unit has to
# exist: the skip is silent, so without it a box could go indefinitely without a working backup
# and nothing would say so. backup-restore.md §3 names this unit as the reason nothing is
# unreported.
Description=Jobbliggaren: verify the host-only secrets are present on tmpfs
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/master-key-ops.md

[Service]
Type=oneshot
# --check-host stats files only and never touches docker: it runs at boot, when dockerd may not
# be up. Same rule, and same reason, as its sibling.
ExecStart=/opt/jobbliggaren/deploy/systemd/jobbliggaren-inject-secrets.sh --check-host
# Self-clearing by construction, like the sibling: the timer re-runs this on a wall clock and the
# first run after an injection exits 0, taking the unit out of `systemctl --failed` with no
# operator action.
RemainAfterExit=no

# NO [Install] SECTION — the timer is what enables this, the same discipline as
# jobbliggaren-secrets-present.service and jobbliggaren-reconcile.service.
