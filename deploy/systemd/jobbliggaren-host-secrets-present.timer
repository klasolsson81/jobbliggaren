[Unit]
# #1329 — drives the host-only absence check (see jobbliggaren-host-secrets-present.service).
Description=Jobbliggaren: periodic check that the host-only secrets are present
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/master-key-ops.md

[Timer]
# Twenty minutes after boot, then hourly.
#
# HOURLY, NOT EVERY TEN MINUTES, and the divergence from the sibling timer is the point of the
# split. Ten minutes is right for a set whose absence means the site is down; this set's absence
# means the NIGHTLY backup cannot upload, so the useful resolution is hours, not minutes. Firing
# six times as often would buy nothing and would spend the alarm surface's credibility on a
# condition nobody can act on faster.
#
# AND THE BOOT OFFSET IS 20 MINUTES BECAUSE THE CLEARING INTERVAL IS AN HOUR — it is not the
# sibling's 2min with a different OnCalendar bolted on. The sibling can afford 2min because it
# self-clears within 10; here a unit that fires before the operator has finished injecting sits on
# `systemctl --failed` until the next full hour, up to ~58 minutes over a condition that no longer
# exists, and jobbliggaren-heartbeat.timer then POSTs /fail on every name in that list — which is
# ONE page, at the transition into failure, and then a surface deaf to the next fault for the whole
# ~58 minutes. The cost is not a burst of pages; it is the deafness. That is the same failure mode
# jobbliggaren-backup.service documents: an alarm lit for a condition that no longer exists trains
# an operator to stop reading the only alarm surface there is. The sibling's own grounding does
# not carry here either: its second half ("on `systemctl --failed` long before anyone notices the
# site is degraded") has no analogue for a set whose absence nobody notices as degradation, and
# its first half is WEAKER here, since the injection script prompts for the host-only set LAST —
# so at T+2min the operator is more likely to be mid-entry on this very credential.
#
# 20min is the house value for an hourly unit: jobbliggaren-backup-fresh.timer uses 20min and
# jobbliggaren-logship-fresh.timer 25min, and both are well inside the 02:15 backup window.
OnBootSec=20min
OnCalendar=hourly
# OnCalendar, NOT OnUnitActiveSec — the same correctness constraint the sibling timer documents
# at length: OnUnitActiveSec= measures from a Type=oneshot unit becoming active, which it never
# does, so the timer would neither re-fire nor clear (systemd#21600). Stated here as the
# constraint, not re-argued; jobbliggaren-secrets-present.timer owns the reasoning.
#
# Deliberately NOT Persistent=true, for the sibling's reason: "are the secrets present right now"
# has no missed-run semantics.
AccuracySec=1min

[Install]
WantedBy=timers.target
