[Unit]
Description=Jobbliggaren: hourly reconcile against the published images
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/vps-deploy-stack.md

[Timer]
# :47, offset from `release-images`' own :17 cron — but the hazard the offset addresses is
# NOT `latest` moving ahead of `sha-<short>` within one image. That split is the publish
# workflow's own idempotence predicate's job, and it repairs itself on the next run.
#
# The real hazard is CROSS-IMAGE SKEW. The publish job is a five-cell matrix with no fan-in:
# each cell pushes when it finishes, so between the first cell's push and the last one's,
# `latest` resolves to the new build for some images and the previous one for others. A pull
# landing in that window installs a MIXED SET — a web from this commit against an api from
# the last — and compose will start it, because every tag resolved to something.
#
# THE OFFSET SHRINKS THAT WINDOW AND NOTHING CLOSES IT. Each cell carries
# `timeout-minutes: 30`, so a slow :17 run can legally still be pushing at :47.
#
# AND ATTESTATION DOES NOT CLOSE IT EITHER — do not read the verification in the wrapper as a
# gate against this. It pins WHO built an image, never WHICH TREE: a `web` from commit A and an
# `api` from commit B were both built by this workflow on main, both carry a valid attestation,
# and both verify. The mixed set is applied. (`release-images.yml` states the same limitation
# about a different hole, and the push-ref condition there is what closes that one.)
#
# What a coherent set would require is that all five images resolve to the same `sha-<short>`,
# which `prepare` already guarantees by resolving ONE commit for all five cells — so pinning
# `IMAGE_TAG` gives a coherent set by construction while `latest` does not. Enforcing that on
# the pull path is owed, not delivered — #1238.
OnCalendar=*-*-* *:47:00

# A box that was off at :47 reconciles on boot rather than waiting up to an hour.
Persistent=true

# Five containers' worth of registry traffic from every box at the same second is not a
# problem at N=1, but the jitter costs nothing and the unit outlives the assumption.
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
