[Unit]
Description=Jobbliggaren: hourly reconcile against the published release
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/vps-deploy-stack.md

[Timer]
# :47, offset from `release-images`' own :17 cron. Until #1238 the offset was the only thing between
# a pull and a MIXED SET — five cells each moving `latest` when they finished, so a pull between the
# first and the last installed images from two commits, every one of them correctly attested (an
# attestation names who built an image, never which tree). Nothing closed that window.
#
# The wrapper this timer starts no longer reads per-image tags: it reads ONE release record, which the
# publisher names from `dev` only after all five images and the record are attested, and it verifies
# each image as built from the record's commit (ADR 0149). A tick that lands mid-publish sees the
# previous release or the next one, whole. The offset now only keeps the two hourly jobs apart.
OnCalendar=*-*-* *:47:00

# A box that was off at :47 reconciles on boot rather than waiting up to an hour.
Persistent=true

# Five containers' worth of registry traffic from every box at the same second is not a
# problem at N=1, but the jitter costs nothing and the unit outlives the assumption.
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
