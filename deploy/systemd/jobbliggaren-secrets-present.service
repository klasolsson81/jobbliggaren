[Unit]
# #198 / ADR 0050 gate B-1 — absence AND at-rest posture detection for the crypto secrets.
#
# WHAT THIS IS, AND WHAT IT IS EXPLICITLY NOT. This detects that the key is MISSING, and since
# #1319/#1320 that the protection around it has drifted. It is not key-ACCESS detection: that half of gate M-7 needs auditd, which is absent from this box
# (measured 2026-08-09), and under this design every illegitimate read of the tmpfs file is by
# construction a root action — which makes it a subset of host root-activity detection, already
# owned by #196/#1201. The disposition is recorded on #1201; it is a named handover, not a drop.
#
# WHY IT EXISTS. The key lives only in RAM (see jobbliggaren-inject-secrets.sh), so every reboot
# destroys it and api/worker crash-loop until an operator injects. A crash-looping container does
# NOT appear in `systemctl --failed` — so without this unit the condition would be invisible on a
# box whose only alarm surface is exactly that list (#1175: no log sink exists).
#
# It doubles as the instrument for an unmeasured premise: the frequency of unplanned reboots is
# unknown (`last reboot` returned no readable history on 2026-08-09). Each firing timestamps one
# in the journal, which is what will eventually let Klas set a real threshold for revisiting the
# no-at-rest-copy decision.
Description=Jobbliggaren: verify the crypto secrets are present and their at-rest posture intact
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/master-key-ops.md

[Service]
Type=oneshot
# --check stats files only and never touches docker: it runs at boot, when dockerd may not be up.
ExecStart=/opt/jobbliggaren/deploy/systemd/jobbliggaren-inject-secrets.sh --check
# Self-clearing by construction: the timer re-runs this on a wall clock (OnCalendar — see the
# timer for why a unit-state-relative interval cannot drive a oneshot), and the first run after
# an injection exits 0, which takes the unit out of `systemctl --failed` with no operator action.
RemainAfterExit=no

# NO [Install] SECTION — the timer is what enables this, the same discipline as
# jobbliggaren-reconcile.service. `systemctl enable` on the service would add nothing and would
# invite a second, redundant activation path.
