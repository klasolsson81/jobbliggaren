[Unit]
# #198 — drives the absence check (see jobbliggaren-secrets-present.service).
Description=Jobbliggaren: periodic check that the crypto secrets are present
Documentation=https://github.com/klasolsson81/jobbliggaren/blob/main/docs/runbooks/master-key-ops.md

[Timer]
# Two minutes after boot: late enough that a same-session operator injecting immediately after a
# PLANNED reboot is not paged by their own maintenance, early enough that an UNPLANNED reboot is
# on `systemctl --failed` long before anyone notices the site is degraded.
OnBootSec=2min
# Then every ten minutes on the wall clock.
#
# OnCalendar, NOT OnUnitActiveSec, and this is a correctness fix rather than a preference.
# `OnUnitActiveSec=` measures from the moment the triggered unit became ACTIVE — and a
# Type=oneshot unit never is: it goes activating -> inactive (or activating -> failed) and
# never passes through active. systemd's own maintainer, on this exact combination:
# "OnUnitActiveSec= is not supported really for Type=oneshot services, since these services
# never are active" (systemd#21600). The earlier form here therefore delivered the boot alarm
# and NOT the two properties this file claimed: it would not re-fire, and — worse — it would
# not clear. The unit would sit in `systemctl --failed` even after a successful injection,
# permanently dirtying the box's only alarm surface, which trains an operator to stop reading
# it. An alarm that is always lit is worse than no alarm.
#
# OnCalendar is state-independent, and it is the form the sibling timer one file over
# (jobbliggaren-reconcile.timer) already runs on this same box.
OnCalendar=*:0/10
# Deliberately NOT Persistent=true. Unlike the reconcile timer there is nothing to catch up on:
# the question "are the secrets present right now" has no missed-run semantics, and a catch-up
# firing would only duplicate the OnBootSec run.
AccuracySec=30s

[Install]
WantedBy=timers.target
