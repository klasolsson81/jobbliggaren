{
  "//": "TEMPLATE — copy to appsettings.Local.json (gitignored) and fill in. The API AND Worker",
  "//1": "fail-fast on startup (Options ValidateOnStart in Infrastructure DI): a missing key throws",
  "//2": "OptionsValidationException naming exactly which one. The four SECTIONS below are the ones",
  "//3": "needing a human-supplied value; ConnectionStrings are required for boot too but arrive via",
  "//4": "an env override, not this file. The Email section at the end is OPTIONAL — omitting it is a",
  "//5": "supported configuration, and is the recommended dev setup.",
  "//6": "Secrets here are STABLE and SHARED: the same FieldEncryption key and AuditPseudonymization",
  "//7": "pepper must be used by the API and the Worker, and must not change against a dev DB that",
  "//8": "already holds data encrypted/pseudonymized under them (see runbook local-dev-setup.md §7).",

  "FieldEncryption": {
    "//": "PII field encryption (ADR 0066, AES-256-GCM). Provider ALREADY defaults to Local, so the",
    "//1": "line below is documentation, not a fix — and any non-Local value now fail-stops loudly in",
    "//2": "DI, because the KMS provider and its client were deleted (#802). It cannot 500 against AWS.",
    "//3": "Do NOT regenerate LocalMasterKeyBase64 against a dev DB with existing encrypted PII —",
    "//4": "data encrypted under the old key becomes unreadable.",
    "Provider": "Local",
    "LocalMasterKeyBase64": "GENERATE ONCE: openssl rand -base64 32"
  },

  "AuditPseudonymization": {
    "//": "Art. 17 erasure audit-trail pseudonymization pepper (ADR 0090 D5, #842). Required since",
    "//1": "2026-07-14; the API AND Worker refuse to start without it (dual-host, AddPersistence).",
    "PepperBase64": "GENERATE ONCE: openssl rand -base64 32"
  },

  "CompanyWatchPseudonymization": {
    "//": "Sole-proprietor org.nr (= personnummer) at-rest tokenization pepper (ADR 0090 D5,",
    "//1": "#544/#942). Required since 2026-07-18; the API AND Worker refuse to start without it.",
    "PepperBase64": "GENERATE ONCE: openssl rand -base64 32"
  },

  "CvReviewFingerprintPseudonymization": {
    "//": "CV-review finding-fingerprint HMAC key (ADR 0093 D2, #692) — keyed HMAC over short CV",
    "//1": "quotes at-rest. Required since 2026-07-19; the API AND Worker refuse to start without it.",
    "PepperBase64": "GENERATE ONCE: openssl rand -base64 32"
  },

  "Email": {
    "//": "OPTIONAL — unlike the four sections above, omitting this whole section is fine and is the",
    "//1": "recommended dev setup. Email:Provider defaults to Console in code (EmailOptions.Provider",
    "//2": "and the DI switch both default to it), which selects ConsoleEmailSender in Development and",
    "//3": "Test: mail is written to the log, confirmation and activation links included, no key needed.",
    "//4": "Outside Development/Test the same value selects NullEmailSender, which sends nothing.",
    "//5": "Set Provider=Ses + a real Email:Ses block to exercise the live e-mail path (ADR 0124).",
    "//6": "DI fail-stops with a named error if the region or either credential is missing, so it is",
    "//7": "never a silent no-op. Leave Provider=Console unless you are deliberately testing SES.",
    "//8": "Keys land HERE and in local-dev-setup.md §2.4/§7 in the SAME PR (CLAUDE.md §11) — a",
    "//9": "template that lags the option fails the next stack-owner's boot one crash at a time",
    "//10": "(#544 org.nr-HMAC, #692 CV-fingerprint peppers both did).",
    "Provider": "Console",
    "FromAddress": "no-reply@localhost",
    "FromName": "Jobbliggaren (dev)",
    "Ses": {
      "//": "REQUIRED ONLY when Provider=Ses; ignored entirely otherwise. Amazon SES v2 over the",
      "//1": "HTTPS API — never SMTP (Netcup drops 25/465/587; ADR 0050 §10). Region is ALWAYS",
      "//2": "explicit: the SDK's own chain (AWS_REGION, ~/.aws/config, IMDS) must never decide which",
      "//3": "jurisdiction mail leaves from (#1169). Credentials are a static IAM user scoped to",
      "//4": "ses:SendEmail — there is no instance role on the VPS. NEVER commit real values; this",
      "//5": "file's live twin is gitignored and gitleaks runs pre-push.",
      "Region": "eu-north-1",
      "AccessKeyId": "FILL IN: access key id for the send-only IAM user",
      "SecretAccessKey": "FILL IN: secret for that same IAM user"
    }
  }
}
