{
  // STEG 12 prod-overlay (TD-21 / TD-17). ConnectionStrings are injected as env-vars by
  // the deployment stack — never committed here. (The ECS task-definition + AWS Secrets
  // Manager that used to do it were destroyed by ADR 0066; #196 owns the replacement.)

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // KnownNetworks is DELIBERATELY EMPTY, so this FILE alone does not boot in Production —
  // that is the point. Api/Program.cs throws fail-loud when the environment is not
  // Development/Test and this list is empty (Sec-Major-1 production-defense, STEG 12), so
  // a misconfigured deploy stops at startup instead of silently collapsing every client
  // into one rate-limit bucket. (An env-var overlay — ForwardedHeaders__KnownNetworks__0 —
  // satisfies the check without editing this file; that is what the tests do.)
  //
  // POPULATING IT IS NECESSARY BUT NOT SUFFICIENT. It silences this check; it does not
  // make per-IP limiting work. UseForwardedHeaders only rewrites RemoteIpAddress when an
  // X-Forwarded-For actually arrives, and measured 2026-08-04 no component in the Option B
  // stack sends one — so six policies that partition on the client IP share one bucket regardless
  // (two of the six do so only for unauthenticated callers) (#1202).
  //
  // The value is the CIDR of the network the reverse proxy connects FROM — the Docker
  // bridge subnet in the Compose stack, never a public address. It is not written here
  // yet because that stack does not exist: no compose file in this repo declares a
  // network, and #196 owns both the stack and this value. Requirement: ADR 0050
  // Amendment 2026-08-04, gate M-5b point 3.
  //
  // ForwardLimit: 1 for a single reverse proxy, which is the Option B topology. Raise to
  // 2 ONLY if a CDN is placed in front of it, and then KnownProxies must be populated
  // too — otherwise ASP.NET stops at the first untrusted hop and RemoteIpAddress becomes
  // the CDN's IP, not the client's, with ForwardLimit=1 semantics and no visible signal.
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  },

  // HSTS — gate:at på ReverseProxy:HttpsEnabled. Header sätts bara på HTTPS-svar; så
  // länge HttpsEnabled=false är detta block ren konfig utan effekt.
  //
  // Under Option B it stays without effect, and flipping the flag would NOT fix that:
  // the API's responses are consumed by a Next route handler and never reach a browser,
  // so browser-visible HSTS is owed outside ASP.NET, on BOTH response paths — Caddy for
  // the 401 that never reaches Next, and buildSecurityHeaders for the Next path (see
  // CLAUDE.md §11). This block is kept as
  // defence-in-depth for a topology where the API is edge-exposed again — it is not a
  // pending launch step. ADR 0050 Amendment 2026-08-04 section 5, gate M-5a.
  //
  // Preload=false initialt — submit till hstspreload.org är prod-launch-step,
  // inte Fas 0. Oåterkalleligt på kort sikt (browsern hardcodar).
  "Hsts": {
    "MaxAgeDays": 365,
    "IncludeSubDomains": true,
    "Preload": false
  }
}
