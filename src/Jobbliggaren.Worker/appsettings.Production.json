{
  // STEG 12 prod-overlay (TD-17). ConnectionStrings (Postgres + HangfireStorage)
  // injiceras via env-vars från ECS task-definition + AWS Secrets Manager
  // (jobbliggaren/prod/postgres-app, jobbliggaren/prod/postgres-worker). Värden committas
  // INTE i overlay. Se docs/runbooks/hangfire-schema.md §4 för GRANT-modell.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // PrepareSchemaIfNecessary=false i prod. Schema-DDL körs via runbook §3
  // (Install.sql) som jobbliggaren_migrations innan första Worker-deploy. Worker-
  // runtime-rollen jobbliggaren_worker har INTE CREATE-rättigheter. Production-
  // defense i Worker/Program.cs throwar om denna flagga är true utanför
  // Development/Test (TD-17 punkt 1).
  "Hangfire": {
    "PrepareSchemaIfNecessary": false,
    "ShutdownTimeoutSeconds": 25
  },

  // Ingestion is dark on a deployed box until someone turns it on deliberately. Platsbanken
  // ingestion writes recruiter contact records, which ADR 0050's gate B-1 covers. B-1 was CLOSED
  // 2026-08-16 (Klas) and the key is no longer plaintext on disk — but this default stays OFF,
  // because B-1 was never the only gate. The corpus load is owned by issue #1240, which names its
  // own gates; while it is open the load is not authorised. Klas confirmed the
  // sequencing 2026-08-05: deploy the stack and take every cutover proof, but land no recruiter
  // contact records until #1240 is closed. NO ONE DISCHARGED GATE IS PERMISSION — several have
  // been discharged already without authorising the load, and this flag stays off through all of
  // them. Read #1240, never a single condition, and never this comment for state.
  // The stream job runs on a ten-minute cron, so the default
  // has to be off HERE rather than remembered at deploy time. Turning it on is a
  // `JobTech__IngestEnabled=true` override on the worker service. It was once described as
  // belonging to "the same change that closes B-1" — that named which change would CARRY the
  // flip while B-1 was the live gate; it never meant that discharging B-1 permits it, and after
  // 2026-08-16 the sentence could only be read the wrong way, so it is gone rather than glossed
  // elsewhere (see JobSourceIngestOptions).
  "JobTech": {
    "IngestEnabled": false
  }
}
