<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jobbliggaren.Api.IntegrationTests</RootNamespace>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- CV-pivot 5c: builds a real personnummer-bearing DOCX in-memory so the import→consent
         re-POST wiring is proven end-to-end against the real extractor (version centrally
         managed in Directory.Packages.props; already a product dependency). -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jobbliggaren.Api\Jobbliggaren.Api.csproj" />
    <ProjectReference Include="..\..\src\Jobbliggaren.Infrastructure\Jobbliggaren.Infrastructure.csproj" />
    <!-- #1232 — JobAdBrowsePlanFixture provisions its database with the SAME Phase A statements
         production issues, so the migration oracle runs under production's privilege posture
         instead of as the Testcontainers superuser. Deliberately NOT a reference to
         Jobbliggaren.Migrate itself: that project has top-level statements, so referencing it
         with InternalsVisibleTo would put a second `Program` in the global namespace alongside
         Api's, and this assembly names WebApplicationFactory<Program> unqualified in 11 files
         (CS0433). -->
    <ProjectReference Include="..\..\src\Jobbliggaren.Migrate.Provisioning\Jobbliggaren.Migrate.Provisioning.csproj" />
  </ItemGroup>

  <!-- #841 - shared JobAdFacets test builder (tests/Shared). Linked rather than duplicated:
       the production JobAdFacets ctor is deliberately strict (all seven args), so the test-side
       ergonomics live in one place. -->
  <ItemGroup>
    <Compile Include="..\Shared\TestFacets.cs" Link="Shared\TestFacets.cs" />
    <Compile Include="..\Shared\TestKeywordExtraction.cs" Link="Shared\TestKeywordExtraction.cs" />
    <Compile Include="..\Shared\TestIds.cs" Link="Shared\TestIds.cs" />
    <Compile Include="..\Shared\RecordingLogger.cs" Link="Shared\RecordingLogger.cs" />
    <!-- #1232 — Phase A provisioning for the migration oracle. Linked rather than duplicated so
         the Worker suite's CompanyRegisterPlanFixture can adopt the same posture without a
         second copy. -->
    <Compile Include="..\Shared\TestDatabaseProvisioner.cs" Link="Shared\TestDatabaseProvisioner.cs" />
  </ItemGroup>
</Project>
