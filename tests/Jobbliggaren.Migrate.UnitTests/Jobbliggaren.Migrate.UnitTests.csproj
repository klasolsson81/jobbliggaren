<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jobbliggaren.Migrate.UnitTests</RootNamespace>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The deploy stack's compose file. Every DeployCompose* class in this project reads it,
         and they outnumber the Migrate-specific ones: the file landed here for
         DeployComposeRoleTests, whose connection strings ARE this project's subject, and the
         later compose pins followed the copy rather than adding a second one. -->
    <Content Include="..\..\deploy\docker-compose.yml"
             Link="deploy\docker-compose.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- #1232 - PooledConnectionResetTests parses every ConnectionStrings__Postgres the repo
         composes. The deploy stack is one surface; CI's e2e host is the other, and it composes
         its own value rather than reading the compose file. -->
    <Content Include="..\..\.github\workflows\e2e.yml"
             Link=".github\workflows\e2e.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jobbliggaren.Migrate\Jobbliggaren.Migrate.csproj" />
  </ItemGroup>

</Project>
