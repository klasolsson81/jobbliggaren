<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jobbliggaren.Worker.IntegrationTests</RootNamespace>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jobbliggaren.Domain\Jobbliggaren.Domain.csproj" />
    <ProjectReference Include="..\..\src\Jobbliggaren.Application\Jobbliggaren.Application.csproj" />
    <ProjectReference Include="..\..\src\Jobbliggaren.Infrastructure\Jobbliggaren.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Jobbliggaren.Worker\Jobbliggaren.Worker.csproj" />
    <ProjectReference Include="..\..\src\Jobbliggaren.Migrate\Jobbliggaren.Migrate.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- #197 PR-2 - the Phase A privilege statements the restore drill's SOURCE database is
         provisioned with, so its tables end up owned by a role the RESTORE target does not have.
         The privilege model is an assembly reference; Migrate is a build-only dependency for the
         CLI fixture, so its top-level Program does not enter this compilation. -->
    <ProjectReference Include="..\..\src\Jobbliggaren.Migrate.Provisioning\Jobbliggaren.Migrate.Provisioning.csproj" />
  </ItemGroup>

  <Target Name="CopyIdentityBootstrapCli" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Jobbliggaren.Migrate\Jobbliggaren.Migrate.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_IdentityBootstrapCliTarget" />
    </MSBuild>
    <Error Condition="'@(_IdentityBootstrapCliTarget->Count())' != '1'"
           Text="The bootstrap fixture requires one unambiguous Migrate target." />
    <PropertyGroup>
      <_IdentityBootstrapCliDirectory>@(_IdentityBootstrapCliTarget->'%(RootDir)%(Directory)')</_IdentityBootstrapCliDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_IdentityBootstrapCliRuntime Include="$(_IdentityBootstrapCliDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_IdentityBootstrapCliRuntime)"
          DestinationFiles="@(_IdentityBootstrapCliRuntime->'$(TargetDir)migrate-cli/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- #841 - shared JobAdFacets test builder (tests/Shared). Linked rather than duplicated:
       the production JobAdFacets ctor is deliberately strict (all seven args), so the test-side
       ergonomics live in one place. -->
  <ItemGroup>
    <Compile Include="..\Shared\TestFacets.cs" Link="Shared\TestFacets.cs" />
    <Compile Include="..\Shared\TestKeywordExtraction.cs" Link="Shared\TestKeywordExtraction.cs" />
    <!-- #197 PR-2 - production's own Phase A posture for the restore drill's source database.
         Linked rather than duplicated for the reason its own docblock gives: a hand-written copy
         of the grants would be a second truth that drifts silently. -->
    <Compile Include="..\Shared\TestDatabaseProvisioner.cs" Link="Shared\TestDatabaseProvisioner.cs" />
    <!-- #1741 PR B - the seam that writes a legacy account name, one home for its provenance. -->
    <Compile Include="..\Shared\LegacyAccountName.cs" Link="Shared\LegacyAccountName.cs" />
  </ItemGroup>
</Project>
