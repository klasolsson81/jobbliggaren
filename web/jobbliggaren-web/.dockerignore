# Build context for the web image is this directory (the root .dockerignore
# excludes `web/` entirely and does not apply here).
#
# The secret patterns below are deliberately WIDER than the repo .gitignore rather
# than a copy of it: this file decides what reaches an image layer, and a layer is
# published. `.env*` rather than three named spellings, and the `**/` forms so a
# nested match is not missed.

# Installed and built output — the image builds both itself.
node_modules/
.next/
out/
.turbo/
**/*.tsbuildinfo

# Tests and their artefacts — not in the image.
tests/
e2e/
playwright-report/
test-results/
coverage/
**/*.test.ts
**/*.test.tsx
vitest.config.ts
playwright.config.ts

# Secrets and local-only files — must never reach a layer.
.env*
**/*.local.ts
**/*.local.json
**/*.pem
**/*.key

# Tooling and docs.
.vscode/
.idea/
*.md
lighthouserc*
scripts/visual-verify.ts

# OS
.DS_Store
Thumbs.db
desktop.ini
